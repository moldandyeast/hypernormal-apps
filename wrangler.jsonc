{
  "name": "hypernormal",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "APP", "class_name": "App" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["App", "Registry"] }],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    // The face runtime ships to browsers as source, so the Worker imports it as
    // text and serves it verbatim at GET /runtime.js. `npm run build:runtime`
    // copies face/runtime.js to src/runtime-source.txt (gitignored, regenerated
    // before every dev, test and deploy) because a Text rule over face/**/*.js
    // would also turn the module the face-runtime tests import into a string.
    { "type": "Text", "globs": ["src/*.txt"], "fallthrough": true }
  ],
  "unsafe": {
    "bindings": [
      { "name": "PUBLIC_RL", "type": "ratelimit", "namespace_id": "3001", "simple": { "limit": 200, "period": 60 } },
      { "name": "LOGIN_RL", "type": "ratelimit", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } }
    ]
  }
}
